    }
  }
  "win-sql-01" = {
    private_ip        = "10.0.20.15"
    processors        = 8
    memory_mb         = 32768
    data_disk_size_gb = 1024
    db_disk_size_gb   = 512
    log_disk_size_gb  = 256
    tags = {
      role               = "sql"
      notes              = "Primary SQL node"
      service_now_ticket = "CHG0000001"
    }
  }
  "win-sql-02" = {
    private_ip        = "10.0.20.16"
    processors        = 8
    memory_mb         = 32768
    data_disk_size_gb = 1024
    db_disk_size_gb   = 512
    log_disk_size_gb  = 256
    tags = {
      role               = "sql"
      notes              = "Secondary SQL node"
      service_now_ticket = "CHG0000001"
    }
  }
  "win-batch-01" = {
    private_ip        = "10.0.20.17"
    processors        = 6
    memory_mb         = 16384
    data_disk_size_gb = 768
    db_disk_size_gb   = 0
    log_disk_size_gb  = 128
    tags = {
      role               = "batch"
      service_now_ticket = "CHG0000001"
    }
  }
  "win-batch-02" = {
    private_ip        = "10.0.20.18"
    processors        = 6
    memory_mb         = 16384
    data_disk_size_gb = 768
    db_disk_size_gb   = 0
    log_disk_size_gb  = 128
    tags = {
      role               = "batch"
      service_now_ticket = "CHG0000001"
    }
  }
  "win-util-01" = {
    private_ip        = "10.0.20.19"
    processors        = 2
    memory_mb         = 8192
    data_disk_size_gb = 0
    db_disk_size_gb   = 0
    log_disk_size_gb  = 0
    tags = {
      role               = "utility"
      service_now_ticket = "CHG0000001"
    }
  }
  "win-util-02" = {
    private_ip        = "10.0.20.20"
    processors        = 2
    memory_mb         = 8192
    data_disk_size_gb = 0
    db_disk_size_gb   = 0
    log_disk_size_gb  = 0
    tags = {
      role               = "utility"
      service_now_ticket = "CHG0000001"
    }
  }
}
