resource_group_name = "rg-azure-local-vms"
location            = "eastus"
# subscription_id     = "00000000-0000-0000-0000-000000000000" # optional override; default is current authenticated subscription
# tenant_id           = "00000000-0000-0000-0000-000000000000" # optional override

# Replace these names with values from your Azure Local environment.
custom_location_id   = "azure-local-cl"
storage_container_id = "default"
logical_network_id   = "lnet-prod"
image_id             = "windows-server-2022"
windows_time_zone    = "Eastern Standard Time"

# Optional settings (shown explicitly so users can tune behavior).
# os_type = "Windows" # default for os_type is "Windows"
# default_vm_size = "Custom" # default for default_vm_size is "Custom"
# dynamic_disks = true # default for dynamic_disks is true
# hyper_v_generation = "V2" # default for hyper_v_generation is "V2"
# enable_automatic_updates = true # default for enable_automatic_updates is true
# provision_vm_agent = true # default for provision_vm_agent is true
# provision_vm_config_agent = true # default for provision_vm_config_agent is true
# enable_tpm = true # default for enable_tpm is true
# secure_boot_enabled = true # default for secure_boot_enabled is true
# security_type = "TrustedLaunch" # default for security_type is "TrustedLaunch"

admin_username = "localadmin"

# Vault KV v2 secret location for the Windows local admin password.
# The secret should contain a key matching vault_admin_password_key.
vault_address                    = "https://vault.example.com"
vault_namespace                  = null
vault_admin_password_kv_mount    = "secret"
vault_admin_password_secret_name = "azure-local/windows-admin"
vault_admin_password_key         = "admin_password"

# Global tags applied to all resources
tags = {
  workload = "azure-local"
  managed  = "terraform"
}

compute_nodes = {
  "win-app-01" = {
    private_ip        = "10.0.20.11"
    processors        = 4
    memory_mb         = 8192
    data_disk_size_gb = 256
    db_disk_size_gb   = 0
    log_disk_size_gb  = 0
    tags = {
      role               = "app"
      notes              = "Primary application node"
      service_now_ticket = "CHG0000001"
    }
  }
  "win-app-02" = {
    private_ip        = "10.0.20.12"
    processors        = 4
    memory_mb         = 8192
    data_disk_size_gb = 512
    db_disk_size_gb   = 256
    log_disk_size_gb  = 128
    tags = {
      role               = "app"
      notes              = "Secondary application node"
      service_now_ticket = "CHG0000001"
    }
  }
  "win-web-01" = {
    private_ip        = "10.0.20.13"
    processors        = 2
    memory_mb         = 4096
    data_disk_size_gb = 128
    db_disk_size_gb   = 0
    log_disk_size_gb  = 0
    tags = {
      role               = "web"
      service_now_ticket = "CHG0000001"
    }
  }
  "win-web-02" = {
    private_ip        = "10.0.20.14"
    processors        = 2
    memory_mb         = 4096
    data_disk_size_gb = 128
    db_disk_size_gb   = 0
    log_disk_size_gb  = 0
    tags = {
